{
  "name": "@x4lt7ab/tab-for-projects",
  "version": "0.1.8",
  "type": "module",
  "bin": {
    "tab-for-projects": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "SQLITE_PATH=.local/data/sqlite.db concurrently --kill-others --names 'api,web' \"bun run --watch src/index.ts\" \"cd src/web && vite build --watch\"",
    "build": "cd src/web && vite build",
    "start": "SQLITE_PATH=.local/data/sqlite.db bun run src/index.ts",
    "serve": "bun run build && bun run start",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "hono": "4.12.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ulid": "2.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vite-plugin-webfont-dl": "3.12.0"
  },
  "overrides": {
    "axios": "1.13.6"
  }
}
