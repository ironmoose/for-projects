{
  "name": "@x4lt7ab/tab-for-projects",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "tab-for-projects": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names 'api,web' \"bun run --watch src/index.ts\" \"cd src/web && vite\"",
    "build": "cd src/web && vite build",
    "start": "bun run src/index.ts",
    "serve": "bun run build && bun run start",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "hono": "^4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ulid": "^2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-webfont-dl": "^3"
  }
}
