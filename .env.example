# --- SQLite (default, zero-config) ---
SQLITE_PATH=./data/sqlite.db

# --- PostgreSQL (optional, enables vector search) ---
# DATABASE_URL=postgresql://tab_projects:tab_projects@localhost:5433/tab_projects

# --- Ollama (optional, required for embeddings) ---
# OLLAMA_HOST=http://localhost:11435

# --- Docker Compose overrides ---
# PG_PORT=5433
# OLLAMA_PORT=11435
# POSTGRES_DB=tab_projects
# POSTGRES_USER=tab_projects
# POSTGRES_PASSWORD=tab_projects

# --- App ---
# PM_HOST=0.0.0.0
# PM_PORT=3000
